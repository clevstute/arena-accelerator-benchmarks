export ARENA_ASCEND_WORKLOAD_DIR=/root/arena-ascend-test5
export ARENA_ASCEND_DRIVER_DIR=/usr/local/Ascend/driver
export ARENA_ASCEND_NPU_A=0
export ARENA_ASCEND_NPU_B=1
