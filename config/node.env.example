# Source this file on the Linux host after setting the local source archive path.
export ARENA_ASCEND_IMAGE=swr.cn-southwest-2.myhuaweicloud.com/base_image/ascend-ci/cann:8.2.rc1-910b-ubuntu22.04-py3.11
export ARENA_ASCEND_CONTAINER=arena-ascend910b3-test5
