# Copy to ~/arena-mrv100-node.env and adjust paths on the MR-V100 host.
export ARENA_MR_TRIAL_DIR="$HOME/arena-mrv100-work"
export ARENA_MR_SOURCE_ARCHIVE="$HOME/arena-iluvatar-src.tar.gz"
export ARENA_MR_DRIVER_DIR=/usr/local/corex/lib
export ARENA_MR_IMAGE='registry.iluvatar.com.cn:10443/release/pytorch:2.10.0-5.0.0_py3.12-corex.5.0.0-ubuntu24.04'

# Optional profile produced by a previous run on the same host and workload.
# export ARENA_MR_PROFILE_FILE="$ARENA_MR_TRIAL_DIR/arena-iluvatar-test5-4layer-vocab-cost.example/profile-corex.pkl"
