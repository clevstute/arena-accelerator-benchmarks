# Copy to ~/arena-mlu-node.env on each training node and edit the values.
export ARENA_MLU_TRIAL_DIR="$HOME/arena-mlu-work"
export ARENA_MLU_NODE_RANK=0
export ARENA_MLU_MASTER_ADDR=192.0.2.10
# Use the local interface facing the other node, e.g. eth0.
export ARENA_MLU_NET_IFACE=
export NEUWARE_HOME=/usr/local/neuware
